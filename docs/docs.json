{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Todo API",
  "colors": {
    "primary": "#F59E0B",
    "light": "#FBBF24",
    "dark": "#D97706"
  },
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Guides",
        "icon": "book-open",
        "pages": [
          "guides/authentication",
          "guides/pagination",
          "guides/deprecations",
          "guides/partner-integrations",
          "guides/enterprise-bulk-import"
        ]
      },
      {
        "group": "API reference",
        "icon": "code",
        "openapi": {
          "source": "openapi.json",
          "directory": "api-reference"
        }
      },
      {
        "group": "GraphQL API",
        "icon": "diagram-project",
        "pages": [
          "graphql/overview"
        ],
        "graphql": {
          "source": "schema.graphql",
          "directory": "graphql/reference"
        }
      },
      {
        "group": "Event stream (WebSocket)",
        "icon": "bolt",
        "pages": [
          "events/overview"
        ],
        "asyncapi": {
          "source": "asyncapi.yaml",
          "directory": "events/reference"
        }
      },
      {
        "group": "Python SDK",
        "icon": "python",
        "pages": [
          "sdk/overview"
        ],
        "sdk": {
          "format": "sphinx",
          "source": "sdk-artifacts/python",
          "directory": "sdk/reference"
        }
      }
    ]
  },
  "api": {
    "playground": {
      "display": "auth",
      "proxy": false
    },
    "examples": {
      "prefill": true,
      "languages": [
        "bash",
        "python",
        "javascript"
      ]
    }
  }
}
