m>) \u2013 Total todos matching the filter.</p></li>\n<li><p><strong>page</strong> (<em>int</em>) \u2013 The current page (starts at 1).</p></li>\n<li><p><strong>page_size</strong> (<em>int</em>) \u2013 Items per page.</p></li>\n<li><p><strong>total_pages</strong> (<em>int</em>) \u2013 How many pages there are.</p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"todo_client.models.TodoPage.items\">\n<span class=\"sig-name descname\"><span class=\"pre\">items</span></span><span class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"pre\">list</span><span class=\"p\"><span class=\"pre\">[</span></span><a class=\"reference internal\" href=\"#todo_client.models.Todo\" title=\"todo_client.models.Todo\"><span class=\"pre\">Todo</span></a><span class=\"p\"><span class=\"pre\">]</span></span></span><a class=\"headerlink\" href=\"#todo_client.models.TodoPage.items\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"todo_client.models.TodoPage.total\">\n<span class=\"sig-name descname\"><span class=\"pre\">total</span></span><span class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"pre\">int</span></span><a class=\"headerlink\" href=\"#todo_client.models.TodoPage.total\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"todo_client.models.TodoPage.page\">\n<span class=\"sig-name descname\"><span class=\"pre\">page</span></span><span class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"pre\">int</span></span><a class=\"headerlink\" href=\"#todo_client.models.TodoPage.page\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"todo_client.models.TodoPage.page_size\">\n<span class=\"sig-name descname\"><span class=\"pre\">page_size</span></span><span class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"pre\">int</span></span><a class=\"headerlink\" href=\"#todo_client.models.TodoPage.page_size\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"todo_client.models.TodoPage.total_pages\">\n<span class=\"sig-name descname\"><span class=\"pre\">total_pages</span></span><span class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"pre\">int</span></span><a class=\"headerlink\" href=\"#todo_client.models.TodoPage.total_pages\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"todo_client.models.TodoPage.has_next\">\n<span class=\"property\"><span class=\"k\"><span class=\"pre\">property</span></span><span class=\"w\"> </span></span><span class=\"sig-name descname\"><span class=\"pre\">has_next</span></span><span class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"pre\">bool</span></span><a class=\"headerlink\" href=\"#todo_client.models.TodoPage.has_next\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p><code class=\"docutils literal notranslate\"><span class=\"pre\">True</span></code> if there is another page after this one.</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"todo_client.models.TodoPage.from_json\">\n<span class=\"property\"><span class=\"k\"><span class=\"pre\">classmethod</span></span><span class=\"w\"> </span></span><span class=\"sig-name descname\"><span class=\"pre\">from_json</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\